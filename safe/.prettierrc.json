{
    "plugins": ["@prettier/plugin-php"],
    "tabWidth": 4,
    "printWidth": 100,
    "singleQuote": true,
    "htmlWhitespaceSensitivity": "ignore",
    "overrides": [
        {
            "files": "*.php",
            "options": {
                "parser": "php",
                "phpVersion": "8.1"
            }
        },
        {
            "files": ["*.css", "*.js", "*.html"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
